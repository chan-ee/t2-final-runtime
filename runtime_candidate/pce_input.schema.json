{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit own-unit PCE conditional-input binding",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "asof_utc", "availability_clock_kind", "sources", "targets"],
  "properties": {
    "schema_version": {"const": "pce-own-unit-v1"},
    "asof_utc": {"type": "string", "format": "date-time"},
    "availability_clock_kind": {"const": "official_published_utc_timestamp"},
    "sources": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/source"}},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "fred_series_id", "provider", "originator", "frequency", "seasonal_adjustment", "statistic", "units", "panel_file", "panel_sha256", "asset_id", "asset_column", "observation_period_column", "value_column", "available_at_column", "vintage_asof_utc", "evidence_file", "evidence_sha256"],
      "properties": {
        "role": {"enum": ["PCE_ALL", "PCE_CORE", "CPI_ALL", "CPI_CORE"]},
        "fred_series_id": {"enum": ["PCEPI", "PCEPILFE", "CPIAUCSL", "CPILFESL"]},
        "provider": {"const": "FRED"}, "originator": {"enum": ["BEA", "BLS"]},
        "frequency": {"const": "Monthly"}, "seasonal_adjustment": {"const": "Seasonally Adjusted"},
        "statistic": {"const": "index_level"},
        "units": {"enum": ["Index 2017=100", "Index 1982-1984=100"]},
        "panel_file": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.parquet$"},
        "panel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "asset_id": {"type": "string", "minLength": 1},
        "asset_column": {"enum": ["asset", "asset_id"]},
        "observation_period_column": {"type": "string", "minLength": 1},
        "value_column": {"type": "string", "minLength": 1},
        "available_at_column": {"type": "string", "minLength": 1},
        "vintage_asof_utc": {"type": "string", "format": "date-time"},
        "evidence_file": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["asset", "horizon", "role", "observation_period", "statistic", "output_value_unit", "provider", "seasonal_adjustment", "forecast_date", "scheduled_first_release_at"],
      "properties": {
        "asset": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 1},
        "role": {"enum": ["PCE_ALL", "PCE_CORE"]},
        "observation_period": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
        "statistic": {"enum": ["index_level", "mom_percent"]},
        "output_value_unit": {"type": "string", "minLength": 1},
        "provider": {"const": "BEA"}, "seasonal_adjustment": {"const": "Seasonally Adjusted"},
        "forecast_date": {"type": "string", "format": "date"},
        "scheduled_first_release_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
